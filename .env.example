# Lumora — environment variables (testnet)
# Copy this as .env / apps/web/.env.local and fill it in.

# --- Network ---
NETWORK=testnet
RPC_URL=https://soroban-testnet.stellar.org
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
HORIZON_URL=https://horizon-testnet.stellar.org

# --- USDC (Circle testnet — VERIFIED) ---
# Issuer (classic asset): 40k+ authorized accounts on Horizon, compatible with the Circle faucet
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# SAC (Soroban contract address) — derived with `stellar contract id asset --asset USDC:$USDC_ISSUER --network testnet`
USDC_SAC_ADDRESS=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
USDC_DECIMALS=7

# --- Lumora contracts (testnet deploy — admin=lumora-dev, token=USDC SAC) ---
# All three are upgradeable (ADR-0001). Treasury was redeployed with the fund_payroll cross-contract auth fix (2026-06-28).
PAYROLL_STREAM_ID=CCAY3UKTW6G4XUXLTWVOUYPHDIR2KOYDWELJ72PZGFBTRGRKC6NSH6OD
PAYROLL_TREASURY_ID=CD5ERANICKKDMD3G7ULGMV5AWXAOMK4AYTIENGZNUTZEMSBIEVVJTFRY
YIELD_STRATEGY_ID=CDYPGBBKXLO7MTTSTRU2K52LOHM7HMOISFABCIA7Y4SYSXQWHIVH22QY

# --- Frontend (Next.js public) ---
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
NEXT_PUBLIC_USDC_SAC_ADDRESS=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
NEXT_PUBLIC_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
NEXT_PUBLIC_PAYROLL_STREAM_ID=CCAY3UKTW6G4XUXLTWVOUYPHDIR2KOYDWELJ72PZGFBTRGRKC6NSH6OD
NEXT_PUBLIC_PAYROLL_TREASURY_ID=CD5ERANICKKDMD3G7ULGMV5AWXAOMK4AYTIENGZNUTZEMSBIEVVJTFRY
NEXT_PUBLIC_YIELD_STRATEGY_ID=CDYPGBBKXLO7MTTSTRU2K52LOHM7HMOISFABCIA7Y4SYSXQWHIVH22QY

# --- Indexer (optional; if apps/indexer is running) ---
# When set, the frontend reads event history/analytics from the indexer (otherwise RPC fallback).
NEXT_PUBLIC_INDEXER_URL=
# The indexer service's own environment (apps/indexer):
# RPC_URL, PAYROLL_STREAM_ID, PAYROLL_TREASURY_ID, DB_PATH, PORT, POLL_INTERVAL_MS
